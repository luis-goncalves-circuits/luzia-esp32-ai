# Modo inicial: free | ollama | claude
AI_MODE=free

# IP/URL do ESP32 na rede local
ESP32_URL=http://192.168.1.50
ESP32_TIMEOUT=3.5

# Ollama local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3

# Claude API (opcional; só necessária em AI_MODE=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Token opcional para proteger a API quando o servidor é partilhado na rede.\n# Define uma sequência aleatória longa antes de usar HOST=0.0.0.0.\nLUZIA_ACCESS_TOKEN=\n\n# Por defeito, o servidor só é acessível neste computador.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
